# ============================================================
#  DaktariScribe — Environment Variables (spec §3.1)
#  Copy this file to .env.local and fill in your real values.
#  NEVER commit .env.local. Never prefix a secret with NEXT_PUBLIC_.
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook endpoint /api/webhooks/clerk (starts whsec_)
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/field-entry
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/field-entry

# Database (Neon) — required from Phase 1
DATABASE_URL=

# App-level encryption (32-byte base64 key; generate with: openssl rand -base64 32) — required from Phase 1
# After a rotation add DATA_ENCRYPTION_KEY_V2=… (new writes use the highest version; keep old keys to read old data)
DATA_ENCRYPTION_KEY=

# Cloudflare R2 (Phase 3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=daktariscribe-private

# Inngest (Phase 2)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local development with the Inngest dev server (npx inngest-cli dev): set INNGEST_DEV=1.
# Without Inngest, jobs run in-process after each request.
INNGEST_DEV=

# AssemblyAI (English STT, Phase 3)
ASSEMBLYAI_API_KEY=

# Sunbird AI (local-language STT + translation, Phase 3/5)
SUNBIRD_BASE_URL=https://api.sunbird.ai
SUNBIRD_USERNAME=
SUNBIRD_PASSWORD=

# Text processing (refinement / OCR / translation, Phase 2) — paid, no-training tier only
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_REFINE=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Payments — Nylon Pay (Phase 7; sandbox keys start npk_sandbox_ / live keys npk_live_; secrets start nps_)
NYLONPAY_API_KEY=
NYLONPAY_API_SECRET=
NYLONPAY_WEBHOOK_SECRET=
# Optional override; the SDK has a default base URL
NYLONPAY_BASE_URL=
# Approximate rate used only for the internal cost ledger
USD_TO_UGX=3700
# Billing is enforced automatically when the Nylon Pay keys are set; force it on with true.
BILLING_ENFORCED=

# Monitoring (Phase 6)
SENTRY_DSN=
