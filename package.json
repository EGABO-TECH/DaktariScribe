{
  "name": "daktari-scribe-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check:copy": "tsx scripts/check-copy.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local db/seed.ts",
    "eval:refine": "tsx scripts/eval-refine.ts",
    "jobs:retry": "tsx --env-file=.env.local scripts/process-stuck.ts",
    "ai:check": "tsx --env-file=.env.local scripts/check-ai.ts",
    "ai:models": "tsx --env-file=.env.local scripts/list-ai-models.ts",
    "exports:check": "node -e \"process.env.EXPORT_LIVE='1';require('child_process').execSync('npx vitest run lib/__tests__/exports-live.test.ts',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@clerk/nextjs": "^7.8.3",
    "@neondatabase/serverless": "^1.2.0",
    "@nile-squad/nylonpay-ts": "^2.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "@serwist/next": "^9.5.13",
    "assemblyai": "^4.42.0",
    "dexie": "^4.4.7",
    "docx": "^9.15.2",
    "drizzle-orm": "^0.45.4",
    "heic2any": "^0.0.4",
    "inngest": "^4.26.2",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.4.38",
    "postcss-preset-env": "^11.5.0",
    "serwist": "^9.5.13",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "zod": "$zod"
  }
}
