# ============================================================
#  DaktariScribe — Environment Variables
#  Copy this file to .env.local and fill in your real values.
#  NEVER commit .env.local to version control.
# ============================================================

# ── Clerk Authentication ─────────────────────────────────────
# Get these from https://clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/field-entry
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/field-entry

# ── AI Configuration ─────────────────────────────────────────
# Used to select AI provider for the application
AI_MODEL_PROVIDER=openai
AI_MODEL_NAME=gpt-4o

# ── Application Settings ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
